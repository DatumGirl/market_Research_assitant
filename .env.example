# you.com Search API key — https://api.you.com
YDC_API_KEY=your_youcom_key_here

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional overrides
MODEL_WORKER=claude-sonnet-5
MODEL_SYNTHESIS=claude-opus-5
MAX_SEARCHES_PER_RUN=40
YOUCOM_CACHE_ENABLED=true
